<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap">
    <p class="section-kicker">Meets, cruises &amp; shows</p>
    <h1 class="page-title">Events Calendar</h1>
    <p class="muted-light">Where Powerpacked will be. Every event on this calendar has a club rep there, multiple members going, or the whole club rolling out.</p>
    <p class="cal-subscribe">Subscribe: <a href="/events.ics">Calendar feed (.ics)</a> &middot; <a href="<%= feedGcalUrl %>">Add to Google Calendar</a></p>
    <% if (currentUser && currentUser.is_admin) { %>
      <p style="margin-top:1rem"><a class="btn btn-red" href="/events/suggest">Suggest an Event</a></p>
    <% } %>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <% if (thisWeek.length || comingUp.length) { %>
      <% if (thisWeek.length) { %>
        <h2 class="section-title">This Week</h2>
        <table class="table events-table">
          <thead><tr><th>Date</th><th>Event</th><th>Who's going</th></tr></thead>
          <tbody>
            <% thisWeek.forEach(day => { %>
              <tr class="day-divider"><td colspan="3"><%= day.label %></td></tr>
              <% day.events.forEach(e => { %>
                <%- include('partials/event-row', { e }) %>
              <% }) %>
            <% }) %>
          </tbody>
        </table>
      <% } %>
      <% if (comingUp.length) { %>
        <h2 class="section-title" style="margin-top:2.5rem">Coming Up</h2>
        <table class="table events-table">
          <thead><tr><th>Date</th><th>Event</th><th>Who's going</th></tr></thead>
          <tbody>
            <% comingUp.forEach(e => { %>
              <%- include('partials/event-row', { e }) %>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    <% } else { %>
      <div class="empty-box empty-large">
        <p class="empty-title">The calendar is wide open</p>
        <p class="muted">No events are scheduled yet. When the club rolls out somewhere, it'll be right here.</p>
        <% if (currentUser && currentUser.is_admin) { %><a class="btn btn-red" href="/events/suggest">Suggest an Event</a>
        <% } else if (!currentUser) { %><a class="btn btn-red" href="/signup">Join the club to stay in the loop</a><% } %>
      </div>
    <% } %>

    <% if (past.length) { %>
      <h2 class="section-title" style="margin-top:3rem">Past Events</h2>
      <table class="table events-table events-table--past">
        <thead><tr><th>Date</th><th>Event</th><th>Who's going</th></tr></thead>
        <tbody>
          <% past.forEach(e => { %>
            <%- include('partials/event-row', { e }) %>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
