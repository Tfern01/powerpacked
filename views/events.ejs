<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap">
    <p class="section-kicker">Meets, cruises &amp; shows</p>
    <h1 class="page-title">Events Calendar</h1>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <% if (upcoming.length) { %>
      <h2 class="section-title">Upcoming</h2>
      <div class="cards">
        <% upcoming.forEach(e => { %>
          <article class="card event-card-static">
            <div class="event-date-badge">
              <span class="d"><%= new Date(e.event_date + 'T12:00:00').getDate() %></span>
              <span class="m"><%= new Date(e.event_date + 'T12:00:00').toLocaleString('en-US', { month: 'short' }).toUpperCase() %></span>
            </div>
            <h3><%= e.title %></h3>
            <p class="muted"><%= new Date(e.event_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %><% if (e.event_time) { %> &middot; <%= e.event_time %><% } %></p>
            <% if (e.location) { %><p class="muted"><%= e.location %></p><% } %>
            <% if (e.description) { %><p><%= e.description %></p><% } %>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-box empty-large">
        <p class="empty-title">The calendar is wide open</p>
        <p class="muted">No events are scheduled yet. When the first meet drops, it'll be right here.</p>
        <a class="btn btn-red" href="/signup">Join the club to stay in the loop</a>
      </div>
    <% } %>

    <% if (past.length) { %>
      <h2 class="section-title" style="margin-top:3rem">Past Events</h2>
      <div class="cards">
        <% past.forEach(e => { %>
          <article class="card event-card-static past">
            <h3><%= e.title %></h3>
            <p class="muted"><%= new Date(e.event_date + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %><% if (e.location) { %> &middot; <%= e.location %><% } %></p>
          </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
