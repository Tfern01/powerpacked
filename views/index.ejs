<%- include('partials/header') %>

<section class="hero">
  <img class="hero-img" src="/images/hero.jpg" alt="Classic muscle car at a golden-hour car meet">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1 class="hero-title">Driven by<br>Difference</h1>
    <div class="hero-cta">
      <a class="btn btn-red btn-big" href="/signup">Join Now</a>
      <a class="btn btn-ghost" href="/gallery">See the Rides</a>
    </div>
  </div>
</section>

<section class="section about-teaser">
  <div class="wrap narrow" style="text-align:center">
    <p class="section-kicker">One community</p>
    <h2 class="section-title">Different cars. Different people.</h2>
    <p class="muted" style="margin-bottom:1.5rem">Powerpacked unites every subsect of car culture under one roof. No gatekeeping, just people who love what moves.</p>
    <a class="btn btn-outline" href="/about">Our Story</a>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="section-kicker">Mark the calendar</p>
        <h2 class="section-title"><a href="/events" class="title-link">Upcoming Events</a></h2>
      </div>
      <a class="btn btn-outline" href="/events">All Events</a>
    </div>
    <% if (upcoming.length) { %>
      <div class="cards">
        <% upcoming.forEach(e => { %>
          <a class="card event-card" href="/events">
            <div class="event-date-badge">
              <span class="d"><%= new Date(e.event_date + 'T12:00:00').getDate() %></span>
              <span class="m"><%= new Date(e.event_date + 'T12:00:00').toLocaleString('en-US', { month: 'short' }).toUpperCase() %></span>
            </div>
            <h3><%= e.title %></h3>
            <% if (e.location) { %><p class="muted"><%= e.location %></p><% } %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-box">
        <p class="empty-title">No events on the calendar yet</p>
        <p class="muted">Meets, cruises, and shows are coming. Check back soon.</p>
        <a class="btn btn-outline" href="/events">View Calendar</a>
      </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="section-kicker">The clubhouse wall</p>
        <h2 class="section-title"><a href="/gallery" class="title-link">Members Corner</a></h2>
      </div>
      <a class="btn btn-outline" href="/gallery">Full Gallery</a>
    </div>
    <a class="carousel" href="/gallery" id="cornerCarousel" aria-label="Members Corner gallery">
      <div class="carousel-track">
        <% if (corner.length) { %>
          <% corner.forEach((c, i) => { %>
            <div class="carousel-slide<%= i === 0 ? ' active' : '' %>">
              <img src="<%= c.photo %>" alt="<%= c.ride_name || c.username %>'s ride">
              <div class="carousel-caption"><strong><%= c.username %></strong><span><%= c.member_number %></span></div>
            </div>
          <% }) %>
        <% } else { %>
          <% ['/images/placeholder-1.jpg','/images/placeholder-2.jpg','/images/placeholder-3.jpg'].forEach((src, i) => { %>
            <div class="carousel-slide<%= i === 0 ? ' active' : '' %>">
              <img src="<%= src %>" alt="Car culture placeholder">
              <div class="carousel-caption"><strong>Your ride here</strong><span>Join the club</span></div>
            </div>
          <% }) %>
        <% } %>
      </div>
      <div class="carousel-dots" id="cornerDots"></div>
    </a>
  </div>
</section>

<section class="cta-band">
  <div class="wrap cta-inner">
    <h2 class="cta-title">Got a ride? You're one of us.</h2>
    <p class="cta-sub">Classic muscle, exotic, truck, bike, side-by-side, EV, if it moves, it belongs. Claim your member number today.</p>
    <a class="btn btn-cream btn-huge" href="/signup">Join Now!</a>
  </div>
</section>

<%- include('partials/footer') %>
