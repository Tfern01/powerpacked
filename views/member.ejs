<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap member-head">
    <% if (member.profile_pic) { %>
      <img class="avatar-lg" src="<%= member.profile_pic %>" alt="<%= member.username %>">
    <% } else { %>
      <div class="avatar-lg avatar-fallback"><%= member.username.charAt(0).toUpperCase() %></div>
    <% } %>
    <div>
      <p class="section-kicker"><%= member.member_number %></p>
      <h1 class="page-title"><%= member.username %></h1>
      <% if (member.bio) { %><p><%= member.bio %></p><% } %>
      <p class="muted">Member since <%= new Date(member.created_at + 'Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) %></p>
    </div>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <h2 class="section-title">The Garage</h2>
    <% if (vehicles.length) { %>
      <div class="cards">
        <% vehicles.forEach(v => { %>
          <article class="card">
            <% if (v.photo) { %><a href="/vehicles/<%= v.id %>"><img class="thumb" src="<%= v.photo %>" alt="<%= v.name %>" loading="lazy"></a><% } %>
            <h3><a href="/vehicles/<%= v.id %>" class="title-link"><%= v.name %></a> <% if (v.is_primary) { %><span class="pill">Primary</span><% } %></h3>
            <p class="muted"><%= [v.year, v.make, v.model].filter(Boolean).join(' ') %></p>
            <div class="card-actions">
              <form action="/vehicles/<%= v.id %>/like" method="POST">
                <button type="submit" class="like-btn<%= v.liked ? ' liked' : '' %>" aria-label="<%= v.liked ? 'Unlike' : 'Like' %> this ride">
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                  <span><%= v.like_count %></span>
                </button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-box"><p class="muted"><%= member.username %> hasn't added any rides yet.</p></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
