<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap">
    <a class="back-link" href="/admin">&larr; Admin</a>
    <h1 class="page-title">Manage Products</h1>
    <a class="btn btn-red" href="/admin/products/new">+ New Product</a>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <% if (products.length) { %>
      <table class="table">
        <thead><tr><th>Product</th><th>Price</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% products.forEach(p => { %>
            <tr>
              <td><strong><%= p.name %></strong></td>
              <td>$<%= (p.price_cents / 100).toFixed(2) %></td>
              <td class="muted"><%= p.active ? 'Live' : 'Hidden' %></td>
              <td class="table-actions">
                <a class="btn btn-outline btn-sm" href="/admin/products/<%= p.id %>/edit">Edit</a>
                <form action="/admin/products/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this product?')"><button class="btn btn-outline btn-sm btn-danger" type="submit">Delete</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-box"><p class="muted">No products yet. The public shop shows a "coming soon" page until you add one.</p></div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
