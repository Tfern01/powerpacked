<%- include('partials/header') %>
<section class="page-head">
  <div class="wrap">
    <p class="section-kicker">Find it</p>
    <h1 class="page-title">Search<% if (q) { %> results for &ldquo;<%= q %>&rdquo;<% } %></h1>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <% if (!q) { %>
      <div class="empty-box"><p class="muted">Type something in the search box up top to find members, rides, and events.</p></div>
    <% } else if (!members.length && !rides.length && !events.length) { %>
      <div class="empty-box empty-large">
        <p class="empty-title">Nothing found for &ldquo;<%= q %>&rdquo;</p>
        <p class="muted">Try a username, a member number like PWR-001, a car make, or an event name.</p>
      </div>
    <% } else { %>
      <% if (members.length) { %>
        <h2 class="section-title">Members</h2>
        <div class="cards">
          <% members.forEach(m => { %>
            <a class="card member-card" href="/member/<%= encodeURIComponent(m.username) %>">
              <% if (m.profile_pic) { %><img class="avatar-sm" src="<%= m.profile_pic %>" alt=""><% } %>
              <div><h3><%= m.username %></h3><p class="muted"><%= m.member_number %></p></div>
            </a>
          <% }) %>
        </div>
      <% } %>
      <% if (rides.length) { %>
        <h2 class="section-title" style="margin-top:2.5rem">Rides</h2>
        <div class="cards">
          <% rides.forEach(r => { %>
            <a class="card" href="/member/<%= encodeURIComponent(r.username) %>">
              <% if (r.photo) { %><img class="thumb" src="<%= r.photo %>" alt="<%= r.name %>" loading="lazy"><% } %>
              <h3><%= r.name %></h3>
              <p class="muted"><%= [r.year, r.make, r.model].filter(Boolean).join(' ') %> &middot; <%= r.username %></p>
            </a>
          <% }) %>
        </div>
      <% } %>
      <% if (events.length) { %>
        <h2 class="section-title" style="margin-top:2.5rem">Events</h2>
        <div class="cards">
          <% events.forEach(e => { %>
            <a class="card" href="/events">
              <h3><%= e.title %></h3>
              <p class="muted"><%= new Date(e.event_date + 'T12:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %><% if (e.location) { %> &middot; <%= e.location %><% } %></p>
            </a>
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
